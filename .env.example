# =============================================================================
# Groww Reviews Analyser - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# For Render deployment, add these as Environment Variables in the dashboard

# =============================================================================
# LLM API KEYS (Required)
# =============================================================================

# Groq API Key - Get from https://console.groq.com/keys
# Used for: Theme extraction and classification
GROQ_API_KEY=your_groq_api_key_here

# Groq Fallback API Key (optional - for rate limit handling)
GROQ_API_KEY_FALLBACK=your_groq_fallback_api_key_here

# Groq API Key for Fee Explainer (Phase 3.5)
# Used for: Exit load bullet point generation
# Can be same as GROQ_API_KEY or separate for rate limit management
GROQ_API_KEY_FEE_EXPLAINER=your_groq_api_key_for_fee_explainer_here

# Google Gemini API Key - Get from https://aistudio.google.com/app/apikey
# Used for: Insight generation
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# EMAIL CONFIGURATION (Required for email delivery)
# =============================================================================

# Resend API Configuration
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address (use Resend's test domain or your verified domain)
# Test domain: onboarding@resend.dev
# Your domain: reports@yourdomain.com (must be verified in Resend dashboard)
RESEND_FROM_EMAIL=onboarding@resend.dev

# =============================================================================
# API SECURITY (Required for GitHub Actions scheduler)
# =============================================================================

# API Token for authenticating scheduled requests
# Generate a secure random token
API_TOKEN=your_secure_api_token_here

# =============================================================================
# MCP / GOOGLE DOC CONFIGURATION (Required for JSON data export)
# =============================================================================

# Google Doc ID for MCP integration (Phase 4)
# The Google Doc where combined JSON data will be appended
# Get from the Google Doc URL: https://docs.google.com/document/d/{DOC_ID}/edit
GOOGLE_DOC_ID=your_google_doc_id_here

# Google OAuth Credentials for MCP (@a-bonus/google-docs-mcp)
# Required for: Phase 4 - Appending JSON data to Google Doc
# 
# To get these credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google Docs API, Google Sheets API, and Google Drive API
# 4. Configure OAuth consent screen (External type)
# 5. Add your email as a test user
# 6. Create OAuth 2.0 credentials (Desktop app type)
# 7. Run: python setup_google_docs_mcp.py
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Database URL (defaults to SQLite if not set)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis URL (for task queue - optional)
# REDIS_URL=redis://localhost:6379/0

# Debug mode
DEBUG=False
